# Server Port
PORT=3000

# MongoDB Connection URI
# If MongoDB is unavailable, the application automatically falls back to local file storage (db.json)
MONGO_URI=mongodb://localhost:27017/it-lease

# JWT Secret Key for Session Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SMTP Configuration (for Password Reset Emails)
# If unconfigured, the system runs in simulation mode: codes are logged to console and saved to last_sent_email.txt
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=it-lease-hub@example.com
